{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "host=x64,version=14.51",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/.tools/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "VCPKG_ROOT": "${sourceDir}/.tools/vcpkg"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "SNOW_APPS_ENABLE_RELEASE_OPTIMIZATION": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/.tools/vcpkg/installed/dynamic",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/cmake/vcpkg-overlay-ports/ffmpeg;${sourceDir}/cmake/vcpkg-overlay-ports/ffmpeg-bin2c;${sourceDir}/cmake/vcpkg-overlay-ports/libheif;${sourceDir}/cmake/vcpkg-overlay-ports/libjxl;${sourceDir}/cmake/vcpkg-overlay-ports/minizip-ng;${sourceDir}/cmake/vcpkg-overlay-ports/onnx;${sourceDir}/cmake/vcpkg-overlay-ports/onnxruntime;${sourceDir}/cmake/vcpkg-overlay-ports/x264;${sourceDir}/cmake/vcpkg-overlay-ports/zxing-cpp;${sourceDir}/cmake/vcpkg-overlay-ports/zlib",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/vcpkg-overlay-triplets",
        "VCPKG_MANIFEST_FEATURES": "snow-shot;full-codecs;image-viewer",
        "SNOW_APPS_STRICT_COMPILE": "ON",
        "SNOW_APPS_ENABLE_CLANG_TIDY": "OFF",
        "SNOW_APPS_BUILD_ANT_DESIGN_QT": "ON",
        "SNOW_APPS_BUILD_SNOW_IMAGE": "ON",
        "SNOW_APPS_BUILD_DRAW_ENGINE": "ON",
        "SNOW_APPS_BUILD_IMAGE_VIEWER": "ON",
        "SNOW_APPS_BUILD_SNOW_SHOT": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDebugDLL",
        "SNOW_APPS_BUILD_TESTS": "ON",
        "SNOW_APPS_BUILD_BENCHMARKS": "OFF",
        "SNOW_APPS_RELEASE_STATIC": "OFF",
        "SNOW_APPS_PACKAGE_SNOW_SHOT": "OFF",
        "SNOW_APPS_API_BASE_URL": "http://localhost:8080",
        "SNOW_IMAGE_PROFILE": "full",
        "SNOW_IMAGE_DEFAULT_LINKAGE": "static"
      }
    },
    {
      "name": "windows-msvc-performance",
      "displayName": "Windows MSVC Performance",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "SNOW_APPS_BUILD_TESTS": "ON",
        "SNOW_APPS_BUILD_BENCHMARKS": "ON",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE": "ON",
        "SNOW_APPS_RELEASE_STATIC": "OFF",
        "SNOW_APPS_PACKAGE_SNOW_SHOT": "OFF",
        "SNOW_APPS_API_BASE_URL": "https://snowshot.top",
        "SNOW_IMAGE_PROFILE": "full",
        "SNOW_IMAGE_DEFAULT_LINKAGE": "static"
      }
    },
    {
      "name": "snow-shot-msvc-release",
      "displayName": "Snow Shot MSVC Static Qt Release",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/.tools/vcpkg/installed/static",
        "VCPKG_MANIFEST_FEATURES": "snow-shot",
        "SNOW_APPS_BUILD_ANT_DESIGN_QT": "ON",
        "SNOW_APPS_BUILD_SNOW_IMAGE": "ON",
        "SNOW_APPS_BUILD_DRAW_ENGINE": "ON",
        "SNOW_APPS_BUILD_IMAGE_VIEWER": "OFF",
        "SNOW_APPS_BUILD_SNOW_SHOT": "ON",
        "SNOW_APPS_BUILD_TESTS": "OFF",
        "SNOW_APPS_BUILD_BENCHMARKS": "OFF",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE": "ON",
        "SNOW_APPS_RELEASE_STATIC": "ON",
        "SNOW_APPS_QT_STATIC": "ON",
        "SNOW_APPS_PACKAGE_SNOW_SHOT": "ON",
        "SNOW_APPS_API_BASE_URL": "https://snowshot.top",
        "SNOW_IMAGE_PROFILE": "redistributable",
        "SNOW_IMAGE_DEFAULT_LINKAGE": "static"
      }
    },
    {
      "name": "snow-shot-msvc-fast",
      "displayName": "Snow Shot MSVC Fast Static Build",
      "inherits": "snow-shot-msvc-release",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "SNOW_APPS_ENABLE_RELEASE_OPTIMIZATION": "OFF",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE": "OFF",
        "SNOW_APPS_PACKAGE_SNOW_SHOT": "OFF",
        "SNOW_RUST_RELEASE_PROFILE": "release-fast"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "targets": ["snow-all"]
    },
    {
      "name": "build-windows-msvc-performance",
      "configurePreset": "windows-msvc-performance",
      "configuration": "Release",
      "targets": ["snow-all"]
    },
    {
      "name": "build-snow-shot-msvc-release",
      "configurePreset": "snow-shot-msvc-release",
      "configuration": "Release",
      "targets": ["snow_shot"]
    },
    {
      "name": "build-snow-shot-msvc-fast",
      "configurePreset": "snow-shot-msvc-fast",
      "configuration": "Release",
      "targets": ["snow_shot"]
    }
  ],
  "testPresets": [
    {
      "name": "test-windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "output": {"outputOnFailure": true},
      "filter": {"exclude": {"label": "interactive|e2e|benchmark"}}
    },
    {
      "name": "test-windows-msvc-performance",
      "configurePreset": "windows-msvc-performance",
      "configuration": "Release",
      "output": {"outputOnFailure": true},
      "filter": {"exclude": {"label": "interactive|e2e|benchmark"}}
    },
    {
      "name": "test-windows-msvc-interactive",
      "configurePreset": "windows-msvc-debug",
      "configuration": "Debug",
      "output": {"outputOnFailure": true},
      "filter": {"include": {"label": "interactive"}}
    }
  ],
  "packagePresets": [
    {
      "name": "package-snow-shot",
      "configurePreset": "snow-shot-msvc-release",
      "generators": ["NSIS"]
    }
  ]
}
