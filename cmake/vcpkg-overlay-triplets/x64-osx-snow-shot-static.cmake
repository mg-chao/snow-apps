set(VCPKG_TARGET_ARCHITECTURE x64)
set(VCPKG_CMAKE_SYSTEM_NAME Darwin)
set(VCPKG_OSX_ARCHITECTURES x86_64)
set(VCPKG_OSX_DEPLOYMENT_TARGET "15.0")
set(VCPKG_CRT_LINKAGE dynamic)
set(VCPKG_LIBRARY_LINKAGE static)
set(VCPKG_BUILD_TYPE release)
string(APPEND VCPKG_C_FLAGS_RELEASE " -O3 -flto -ffunction-sections -fdata-sections")
string(APPEND VCPKG_CXX_FLAGS_RELEASE " -O3 -flto -ffunction-sections -fdata-sections")
string(APPEND VCPKG_LINKER_FLAGS_RELEASE " -flto -Wl,-dead_strip")

if(PORT STREQUAL "x265")
    list(APPEND VCPKG_CMAKE_CONFIGURE_OPTIONS -DHIGH_BIT_DEPTH=ON -DMAIN12=OFF)
endif()
