include_guard(GLOBAL)

# Use the build target's Cargo configuration, rather than a second feature list in packaging.
function(snow_install_rust_licenses)
    cmake_parse_arguments(NOTICES "" "COMPONENT;DESTINATION" "TARGETS" ${ARGN})
    set(SNOW_LICENSE_RESET_DESTINATION ON)
    foreach(_target IN LISTS NOTICES_TARGETS)
        if(NOT TARGET "${_target}")
            continue()
        endif()
        get_target_property(SNOW_LICENSE_MANIFEST_DIR "${_target}" SNOW_RUST_MANIFEST_DIR)
        if(NOT SNOW_LICENSE_MANIFEST_DIR)
            # Interface wrappers and native binaries have no independent Cargo configuration.
            continue()
        endif()
        find_package(Python3 COMPONENTS Interpreter REQUIRED)
        find_program(CARGO_EXECUTABLE NAMES cargo REQUIRED)
        get_target_property(_toolchain "${_target}" SNOW_RUST_TOOLCHAIN)
        set(SNOW_LICENSE_ENVIRONMENT "")
        if(_toolchain)
            set(SNOW_LICENSE_ENVIRONMENT "RUSTUP_TOOLCHAIN=${_toolchain}")
        endif()
        get_target_property(SNOW_LICENSE_PACKAGE "${_target}" SNOW_RUST_PACKAGE)
        get_target_property(SNOW_LICENSE_TARGET "${_target}" SNOW_RUST_TARGET)
        get_target_property(_features "${_target}" SNOW_RUST_FEATURES)
        set(SNOW_LICENSE_FEATURES "")
        if(_features)
            list(JOIN _features "," SNOW_LICENSE_FEATURES)
        endif()
        get_target_property(_no_default_features "${_target}" SNOW_RUST_NO_DEFAULT_FEATURES)
        set(SNOW_LICENSE_DEFAULT_ARGUMENT "")
        if(_no_default_features)
            set(SNOW_LICENSE_DEFAULT_ARGUMENT --no-default-features)
        endif()
        set(SNOW_LICENSE_DESTINATION "${NOTICES_DESTINATION}")
        set(SNOW_LICENSE_SOURCE_DIR "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../scripts")
        set(SNOW_LICENSE_FALLBACK_DIR "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../licenses")
        set(_script
            "${CMAKE_CURRENT_BINARY_DIR}/InstallRustLicenses-${NOTICES_COMPONENT}-${_target}.cmake")
        configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/InstallRustLicenses.cmake.in"
            "${_script}" @ONLY)
        install(SCRIPT "${_script}" COMPONENT "${NOTICES_COMPONENT}")
        set(SNOW_LICENSE_RESET_DESTINATION OFF)
    endforeach()
endfunction()
