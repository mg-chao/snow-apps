include_guard(GLOBAL)

function(snow_x265_cache_bool cache name result)
    file(STRINGS "${cache}" _values REGEX "^${name}:[^=]+=")
    list(LENGTH _values _count)
    if(_count EQUAL 0)
        # Upstream only creates MAIN12 for high-bit-depth configurations and
        # LINKED_* options when EXTRA_LIB is nonempty. Their absent value is OFF.
        if(name MATCHES "^(MAIN12|LINKED_[0-9]+BIT|HIGH_BIT_DEPTH)$")
            set(${result} FALSE PARENT_SCOPE)
            return()
        endif()
        message(FATAL_ERROR "x265 capability cache is missing ${name}: ${cache}")
    endif()
    if(NOT _count EQUAL 1)
        message(FATAL_ERROR "x265 capability cache repeats ${name}: ${cache}")
    endif()
    string(REGEX REPLACE "^[^=]+=" "" _value "${_values}")
    string(TOUPPER "${_value}" _value)
    if(_value MATCHES "^(ON|TRUE|YES|1)$")
        set(${result} TRUE PARENT_SCOPE)
    elseif(_value MATCHES "^(OFF|FALSE|NO|0|)$")
        set(${result} FALSE PARENT_SCOPE)
    else()
        message(FATAL_ERROR "x265 capability cache has invalid ${name}=${_value}: ${cache}")
    endif()
endfunction()

function(snow_x265_read_capabilities cache result)
    if(NOT EXISTS "${cache}")
        message(FATAL_ERROR "x265 capability cache was not generated: ${cache}")
    endif()
    foreach(_name IN ITEMS HIGH_BIT_DEPTH MAIN12 LINKED_8BIT LINKED_10BIT LINKED_12BIT
                           EXPORT_C_API ENABLE_DYNAMIC_DEPTH)
        snow_x265_cache_bool("${cache}" "${_name}" _${_name})
    endforeach()
    set(_bitDepth8 ${_LINKED_8BIT})
    set(_bitDepth10 ${_LINKED_10BIT})
    set(_bitDepth12 ${_LINKED_12BIT})
    if(NOT _HIGH_BIT_DEPTH)
        set(_bitDepth8 TRUE)
    elseif(_MAIN12)
        set(_bitDepth12 TRUE)
    else()
        set(_bitDepth10 TRUE)
    endif()
    set(_singlePublicApi ${_EXPORT_C_API})
    set(_dynamicDepthLoading ${_ENABLE_DYNAMIC_DEPTH})
    set(_json "{\n  \"schemaVersion\": 2")
    foreach(_field IN ITEMS bitDepth8 bitDepth10 bitDepth12 singlePublicApi dynamicDepthLoading)
        if(_${_field})
            set(_value true)
        else()
            set(_value false)
        endif()
        string(APPEND _json ",\n  \"${_field}\": ${_value}")
    endforeach()
    string(APPEND _json "\n}\n")
    set(${result} "${_json}" PARENT_SCOPE)
endfunction()

function(snow_x265_write_capabilities)
    cmake_parse_arguments(PARSE_ARGV 0 ARG "REQUIRE_MAIN8;REQUIRE_8BIT_ONLY" "OUTPUT_FILE" "CACHES")
    if(NOT ARG_OUTPUT_FILE OR NOT ARG_CACHES OR ARG_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "x265 capabilities require OUTPUT_FILE and configured CACHES")
    endif()
    set(_previous "")
    foreach(_cache IN LISTS ARG_CACHES)
        snow_x265_read_capabilities("${_cache}" _current)
        if(NOT _previous STREQUAL "" AND NOT _current STREQUAL _previous)
            message(FATAL_ERROR "x265 release/debug encoder capabilities disagree: ${_cache}")
        endif()
        set(_previous "${_current}")
    endforeach()
    string(JSON _eight GET "${_current}" bitDepth8)
    string(JSON _ten GET "${_current}" bitDepth10)
    string(JSON _twelve GET "${_current}" bitDepth12)
    string(JSON _public GET "${_current}" singlePublicApi)
    string(JSON _dynamic GET "${_current}" dynamicDepthLoading)
    if(ARG_REQUIRE_MAIN8 AND (NOT _eight OR NOT _public))
        message(FATAL_ERROR "x265[main8] was overridden: an 8-bit public API is required")
    endif()
    if(ARG_REQUIRE_8BIT_ONLY AND (_ten OR _twelve OR _dynamic))
        message(FATAL_ERROR "x265[main8] was overridden: only the compiled 8-bit API is allowed")
    endif()
    get_filename_component(_directory "${ARG_OUTPUT_FILE}" DIRECTORY)
    file(MAKE_DIRECTORY "${_directory}")
    file(WRITE "${ARG_OUTPUT_FILE}" "${_current}")
endfunction()
