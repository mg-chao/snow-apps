+    if (vtctx->dts_pts) {
+        /* Delay the submitted timeline by frames, not by a constant time.
+         * VideoToolbox's decode clock minus the initial pts distance only
+         * works for constant-rate input. For sparse pictures a later gap
+         * can otherwise make dts exceed pts. Keep the initial negative
+         * prefix, then consume input timestamps in presentation order.
+         * A clip shorter than the reorder delay has no reordered pictures.
+         */
+        if (vtctx->dts_delta >= 0 && vtctx->frame_ct_out <= vtctx->has_b_frames) {
+            status = av_fifo_peek(vtctx->dts_pts, &pkt->dts, 1, vtctx->frame_ct_out - 1);
+            if (status >= 0)
+                pkt->dts -= vtctx->dts_delta;
+        } else {
+            status = av_fifo_read(vtctx->dts_pts, &pkt->dts, 1);
+        }
+        if (status < 0)
+            goto end_nopkt;
+    }
 
