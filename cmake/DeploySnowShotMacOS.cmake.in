set(_app "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/snow_shot.app")
# Remove the obsolete helper from reused install/package staging directories.
file(REMOVE "${_app}/Contents/MacOS/snow-shot-updater")
set(_snow_codesign_identity [==[@SNOW_MACOS_CODESIGN_IDENTITY@]==])
if(_snow_codesign_identity STREQUAL "-")
    message(WARNING "Snow Shot is ad-hoc signed. Rebuilds can invalidate macOS privacy grants even when System Settings shows them enabled. Use SNOW_MACOS_CODESIGN_IDENTITY with a persistent certificate to retain the signing identity.")
endif()
string(TOLOWER "${CMAKE_INSTALL_CONFIG_NAME}" _snow_install_config)
set(_snow_ocr_runtime_arguments)
if(@SNOW_SHOT_OCR_STATIC_ONNXRUNTIME@)
    list(APPEND _snow_ocr_runtime_arguments --static-runtime)
endif()
if(_snow_install_config STREQUAL "debug")
    set(_snow_vcpkg_library_dir "@SNOW_FFMPEG_ROOT@/debug/lib")
else()
    set(_snow_vcpkg_library_dir "@SNOW_FFMPEG_ROOT@/lib")
endif()
if(@SNOW_MACOS_OCR_ASSETS_ENABLED@ AND NOT @SNOW_SHOT_OCR_STATIC_ONNXRUNTIME@)
    execute_process(COMMAND "@Python3_EXECUTABLE@" "@SNOW_MACOS_OCR_TOOL@" prepare-bundle
        --app "${_app}" --library-dir "${_snow_vcpkg_library_dir}"
        COMMAND_ERROR_IS_FATAL ANY)
else()
    execute_process(COMMAND "@Python3_EXECUTABLE@" "@SNOW_MACOS_OCR_TOOL@" prepare-bundle
        --app "${_app}" COMMAND_ERROR_IS_FATAL ANY)
endif()
if(NOT @SNOW_SHOT_QT_STATIC@)
    # This dlopen-only library is deliberately renamed to ORT's stable lookup name.
    # Update its own Mach-O ID before macdeployqt scans it as an extra executable.
    execute_process(COMMAND /usr/bin/install_name_tool -id "@loader_path/libonnxruntime.dylib"
        "${_app}/Contents/MacOS/libonnxruntime.dylib" RESULT_VARIABLE _result)
    if(NOT _result EQUAL 0)
        message(FATAL_ERROR "Could not update the ONNX Runtime install name (${_result})")
    endif()
    execute_process(COMMAND "@SNOW_MACDEPLOYQT@" "${_app}"
        "-executable=${_app}/Contents/MacOS/snow-ocr-process"
        "-executable=${_app}/Contents/MacOS/libonnxruntime.dylib"
        "-executable=${_app}/Contents/PlugIns/platforms/libqoffscreen.dylib"
        "-libpath=${_snow_vcpkg_library_dir}"
        -always-overwrite "-codesign=${_snow_codesign_identity}"
        RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _error)
    if(NOT _result EQUAL 0 OR "${_output}${_error}" MATCHES "ERROR:")
        message(FATAL_ERROR "macdeployqt failed (${_result}):\n${_output}\n${_error}")
    endif()
elseif(@SNOW_SHOT_QT_STATIC@)
    file(GLOB_RECURSE _snow_bundle_files LIST_DIRECTORIES FALSE "${_app}/Contents/*")
    foreach(_snow_bundle_file IN LISTS _snow_bundle_files)
        if(IS_SYMLINK "${_snow_bundle_file}")
            continue()
        endif()
        execute_process(COMMAND /usr/bin/file -b "${_snow_bundle_file}"
            OUTPUT_VARIABLE _snow_file_type OUTPUT_STRIP_TRAILING_WHITESPACE)
        if(NOT _snow_file_type MATCHES "Mach-O")
            continue()
        endif()
        execute_process(COMMAND /usr/bin/otool -L "${_snow_bundle_file}"
            OUTPUT_VARIABLE _snow_loads COMMAND_ERROR_IS_FATAL ANY)
        string(REPLACE "\n" ";" _snow_load_lines "${_snow_loads}")
        list(REMOVE_AT _snow_load_lines 0)
        foreach(_snow_load_line IN LISTS _snow_load_lines)
            string(STRIP "${_snow_load_line}" _snow_load_line)
            if(_snow_load_line STREQUAL "")
                continue()
            endif()
            string(REGEX REPLACE "[ \t]+\\(compatibility version.*$" "" _snow_dependency "${_snow_load_line}")
            if(NOT _snow_dependency MATCHES "^(/usr/lib/|/System/Library/)")
                message(FATAL_ERROR
                    "Static package contains a non-system dependency: ${_snow_bundle_file}: ${_snow_dependency}")
            endif()
        endforeach()
        execute_process(COMMAND /usr/bin/codesign --force --sign "${_snow_codesign_identity}"
            "${_snow_bundle_file}" COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
endif()
if(@SNOW_MACOS_OCR_ASSETS_ENABLED@)
    # Deployment has finalized and signed the nested Mach-O files. Pin those
    # final bytes, then seal the changed resources without re-signing the worker.
    execute_process(COMMAND "@Python3_EXECUTABLE@" "@SNOW_MACOS_OCR_TOOL@" finalize --deployed
        --manifest "@SNOW_MACOS_OCR_MANIFEST@"
        --runtime-dir "${_app}/Contents/MacOS"
        ${_snow_ocr_runtime_arguments}
        COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND /usr/bin/codesign --force --sign "${_snow_codesign_identity}" "${_app}"
        COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "@Python3_EXECUTABLE@" "@SNOW_MACOS_OCR_TOOL@" verify
        --manifest "@SNOW_MACOS_OCR_MANIFEST@"
        --runtime-dir "${_app}/Contents/MacOS" --app "${_app}"
        --report "@CMAKE_BINARY_DIR@/macos-ocr-verification.json"
        ${_snow_ocr_runtime_arguments}
        COMMAND_ERROR_IS_FATAL ANY)
elseif(@SNOW_SHOT_QT_STATIC@)
    execute_process(COMMAND /usr/bin/codesign --force --sign "${_snow_codesign_identity}" "${_app}"
        COMMAND_ERROR_IS_FATAL ANY)
endif()
execute_process(COMMAND /usr/bin/codesign --verify --deep --strict "${_app}"
    RESULT_VARIABLE _result)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Snow Shot bundle signature verification failed (${_result})")
endif()
