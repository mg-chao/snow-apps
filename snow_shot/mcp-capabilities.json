    "recording_pinned": {
      "scope": "Recording lifecycle, pinned images and groups",
      "tools": [
        "snow_shot_recording_state",
        "snow_shot_recording_start",
        "snow_shot_recording_control",
        "snow_shot_pinned_list",
        "snow_shot_pinned_get",
        "snow_shot_pinned_create",
        "snow_shot_pinned_replace",
        "snow_shot_pinned_update",
        "snow_shot_pinned_action",
        "snow_shot_pinned_export",
        "snow_shot_pinned_edit",
        "snow_shot_group_list",
        "snow_shot_group_update"
      ]
    }
  },
  "validation": {
    "windows_protocol": "verified by crate tests and five-version stdio smoke",
    "windows_native": "release gate: native desktop capture, clipboard, pinned UI, recording and OS permissions",
    "macos_native": "deferred by user: this iteration validates Windows only; native arm64/x64 capture permissions, recording and bundle launch remain unverified"
  },
  "surface_contracts": {
    "settings_field_kinds": {
      "adapter": "settingsJson/settingsValue; runtime catalog roundtrip in mcp_application_tests",
      "members": [
        "Select",
        "Switch",
        "Integer",
        "MultiSelect",
        "Slider",
        "Color",
        "Radio",
        "FilePath",
        "DirectoryPath",
        "Text",
        "ShortcutAction",
        "LocalShortcut",
        "GlobalMouseAction",
        "Action",
        "Custom"
      ]
    },
    "settings_action_bindings": {
      "adapter": "registry fieldForAction, settings_action dispatches SettingsRuntimeSession.triggerAction",
      "members": [
        "OpenLoginItemSettings",
        "RestartAsAdministrator",
        "ClearCaptureHistory",
        "ClearPinnedHistory",
        "ClearThumbnailCache",
        "ClearRecordingTemp",
        "CopyTodayLog",
        "ExportConfiguration",
        "ImportConfiguration"
      ]
    },
    "settings_custom_renderers": {
      "adapter": "settings_get metadata; writable toolbar/tray fields plus dedicated models/permissions/status/storage APIs",
      "members": [
        "McpStatus",
        "PermissionScreenRecording",
        "PermissionAccessibility",
        "PermissionInputMonitoring",
        "PermissionMicrophone",
        "CustomAiModels",
        "StorageStatus",
        "DrawingToolbarEditor",
        "ScreenshotToolbarEditor",
        "PinnedToolbarEditor",
        "TrayMenuOptions"
      ]
    },
    "canvas_style_sources": {
      "adapter": "tool style and selected element editors; source enumeration reviewed, native behavior requires platform gate",
      "members": [
        "DefaultRectangle",
        "SelectedRectangle",
        "DefaultArrow",
        "SelectedArrow",
        "DefaultLine",
        "SelectedLine",
        "DefaultFreeDraw",
        "SelectedFreeDraw",
        "DefaultRectangleHighlight",
        "SelectedRectangleHighlight",
        "Eraser",
        "DefaultRectangleFilter",
        "DefaultFilter",
        "SelectedRectangleFilter",
        "SelectedFilter",
        "Watermark",
        "DefaultText",
        "SelectedText",
        "DefaultSerialNumber",
        "SelectedSerialNumber",
        "DefaultPenHighlight",
        "SelectedPenHighlight",
        "DefaultPenFilter",
        "SelectedPenFilter",
        "DefaultSpotlight",
        "SelectedSpotlight"
      ]
    },
    "canvas_tools": {
      "adapter": "typed CanvasTool enumeration and application/drawing engine dispatch",
      "members": {
        "Select": "Select",
        "Shape": "Rectangle",
        "Arrow": "Arrow",
        "Line": "Line",
        "FreeDraw": "Freehand",
        "RectangleHighlight": "RectangleHighlight",
        "Highlight": "RectangleHighlight",
        "Eraser": "Eraser",
        "RectangleFilter": "RectangleFilter",
        "Filter": "RectangleFilter",
        "Watermark": "Watermark",
        "Text": "Text",
        "SerialNumber": "SerialNumber",
        "PenHighlight": "PenHighlight",
        "PenFilter": "PenFilter",
        "Spotlight": "Spotlight",
        "AutoFilter": "AutoFilter"
      }
    },
    "recording_options": {
      "adapter": "ScreenRecordingController.automationStart; native encoder/audio outcomes require platform gate",
      "members": [
        "path",
        "format",
        "start_delay_seconds",
        "microphone",
        "system_audio",
        "frame_rate",
        "animated_frame_rate",
        "clarity",
        "animated_clarity",
        "encoder",
        "encoding_preset",
        "loop",
        "capture_toolbar",
        "show_cursor",
        "show_keyboard",
        "mouse_highlight",
        "record_mouse_clicks",
        "mouse_trail_duration_ms",
        "keyboard_size",
        "keyboard_background",
        "keyboard_foreground",
        "mouse_trail",
        "mouse_click",
        "mouse_highlight_color"
      ]
    },
    "settings_shortcut_adjustments": {
      "adapter": "Settings catalog-derived auxiliary field IDs and settings_get/update",
      "members": [
        "None",
        "ScreenshotDelaySeconds"
      ]
    },
    "recognition_actions": {
      "adapter": "Actual headless recognition text/table editing controller and typed Rust actions; covered by recognition IPC workflows",
      "members": [
        "set_text", "reset_text", "format", "punctuation", "select_cells", "set_cell",
        "merge_cells", "split_cells", "reset_table", "show_original", "undo", "redo"
      ]
    }
  }
}
