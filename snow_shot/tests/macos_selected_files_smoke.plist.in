<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key><string>com.snowshot.selected-files-smoke</string>
    <key>CFBundleName</key><string>Snow Shot Finder Selection Test</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>NSAppleEventsUsageDescription</key><string>This test reads Finder's selected files to verify Snow Shot file pinning.</string>
</dict></plist>
