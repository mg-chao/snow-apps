#include <windows.h>

#define IDI_SNOW_SHOT_APPLICATION 101

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@CMAKE_CURRENT_BINARY_DIR@/generated/windows-app.manifest"
IDI_SNOW_SHOT_APPLICATION ICON DISCARDABLE "@CMAKE_CURRENT_SOURCE_DIR@/resources/app-icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "@SNOW_SHOT_VENDOR@\0"
            VALUE "FileDescription", "@SNOW_SHOT_PRODUCT_NAME@ screenshot utility\0"
            VALUE "FileVersion", "@PROJECT_VERSION@.0\0"
            VALUE "InternalName", "@SNOW_SHOT_EXECUTABLE_NAME@\0"
            VALUE "LegalCopyright", "@SNOW_SHOT_COPYRIGHT@\0"
            VALUE "OriginalFilename", "@SNOW_SHOT_EXECUTABLE_NAME@.exe\0"
            VALUE "ProductName", "@SNOW_SHOT_PRODUCT_NAME@\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
