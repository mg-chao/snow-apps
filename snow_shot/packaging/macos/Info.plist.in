<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
    <key>CFBundleIdentifier</key><string>com.snowshot.snow_shot</string>
    <key>CFBundleName</key><string>Snow Shot</string>
    <key>CFBundleDisplayName</key><string>Snow Shot</string>
    <key>CFBundleIconFile</key><string>${MACOSX_BUNDLE_ICON_FILE}</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleVersion</key><string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
    <key>CFBundleShortVersionString</key><string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
    <key>LSMinimumSystemVersion</key><string>${CMAKE_OSX_DEPLOYMENT_TARGET}</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSMicrophoneUsageDescription</key><string>Snow Shot records microphone audio when you enable it for a screen recording.</string>
    <key>NSAudioCaptureUsageDescription</key><string>Snow Shot captures system audio when you enable it for a screen recording.</string>
</dict>
</plist>
